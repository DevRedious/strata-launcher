{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Strata Launcher",
    "version": "0.3.0",
    "identifier": "fr.redious.strata.launcher",
    "build": {
        "frontendDist": "../src"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Strata",
                "width": 760,
                "height": 560,
                "resizable": false,
                "maximizable": false,
                "center": true,
                "backgroundColor": "#0a0b0f"
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": false,
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
        "copyright": "© 2026 DevRedious · GPL-3.0-or-later",
        "publisher": "DevRedious"
    }
}
